##
# Leantime – Umgebungsvariablen
#
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
#
# Alternativ das Skript generate-env.sh verwenden:
#   bash generate-env.sh
#
# Alle möglichen Variablen:
#   https://github.com/Leantime/leantime/blob/master/config/sample.env
##

# Leantime-Image-Tag (3.4.12, latest, …)
TAG=3.4.12

# MySQL-Version (8.4, 8.0, …)
MYSQL_VERSION=8.4

# Öffentlicher Hostname (z. B. leantime.deinedomain.de)
APP_HOST=leantime.deinedomain.de

# Proxy-Netzwerk (muss mit dem Gateway-Netzwerk übereinstimmen)
PROXY_NETWORK=proxy_net

# ─── Datenbank ───────────────────────────────────────────────────────────────
LEAN_DB_DATABASE=leantime
LEAN_DB_USER=leantime
LEAN_DB_PASSWORD=p4ssw0rd
MYSQL_ROOT_PASSWORD=p4ssw0rd

# ─── Session ─────────────────────────────────────────────────────────────────
# Session-Salt – mit openssl rand -hex 32 generieren
# WICHTIG: Diesen Wert sicher aufbewahren! Bei Verlust sind bestehende
# Sessions ungültig.
LEAN_SESSION_PASSWORD=OVERWRITE_ME

# ─── App-Konfiguration ──────────────────────────────────────────────────────
LEAN_SITENAME=Leantime
LEAN_LANGUAGE=en-US
LEAN_DEFAULT_TIMEZONE=Europe/Berlin
LEAN_DEBUG=0

# ─── E-Mail (optional, für ausgehende E-Mails) ──────────────────────────────
# LEAN_EMAIL_RETURN=leantime@deinedomain.de
# LEAN_EMAIL_USE_SMTP=true
# LEAN_EMAIL_SMTP_HOSTS=smtp.example.com
# LEAN_EMAIL_SMTP_USERNAME=user@example.com
# LEAN_EMAIL_SMTP_PASSWORD=secret
# LEAN_EMAIL_SMTP_PORT=587
# LEAN_EMAIL_SMTP_SECURE=TLS