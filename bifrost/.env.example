##
# Bifrost – Umgebungsvariablen
##

# Image-Tag
TAG=latest

# Öffentlicher Hostname (für gatectl-Registrierung)
APP_HOST=bifrost.deinedomain.de

# Proxy-Netzwerk (muss mit dem Gateway-Netzwerk übereinstimmen)
PROXY_NETWORK=proxy_net

# Log-Level (debug, info, warn, error)
LOG_LEVEL=info

# Log-Style (json, pretty)
LOG_STYLE=json

# Daten-Volume-Name
BIFROST_DATA=bifrost_data

# ─── API Keys (optional, für env-Referenzen in config.json) ────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...