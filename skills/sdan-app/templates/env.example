##
# <APP_NAME> – Umgebungsvariablen
#
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
#
# Alternativ das Skript generate-env.sh verwenden:
#   bash generate-env.sh
##

# Image-Tag
TAG=latest

# Öffentlicher Hostname (z. B. <APP_NAME>.deinedomain.de)
APP_HOST=<APP_NAME>.deinedomain.de

# Proxy-Netzwerk (muss mit dem Gateway-Netzwerk übereinstimmen)
PROXY_NETWORK=proxy_net

# Secret Key Base – mit openssl rand -hex 64 generieren
# WICHTIG: Diesen Wert sicher aufbewahren! Bei Verlust sind Sessions und
# verschlüsselte Datenbankinhalte unlesbar.
SECRET_KEY_BASE=OVERWRITE_ME

# Datenbank (falls die App eine nutzt)
POSTGRES_VERSION=17
POSTGRES_PASSWORD=p4ssw0rd