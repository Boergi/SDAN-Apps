##
# Taiga 6.9.0 – Umgebungsvariablen
# Kopiere diese Datei nach .env: cp .env.example .env
# Alternativ: bash generate-env.sh
#
# Die Werte TAIGA_SCHEME/DOMAIN/SUBPATH/WEBSOCKETS_SCHEME müssen zur
# öffentlichen Gateway-URL passen. Bei einer Subdomain bleibt SUBPATH leer.
##

TAG=6.9.0
POSTGRES_VERSION=12.3
PROXY_NETWORK=proxy_net

# Öffentliche URL hinter dem SDAN-Gateway
TAIGA_SCHEME=https
TAIGA_DOMAIN=taiga.deinedomain.de
SUBPATH=
WEBSOCKETS_SCHEME=wss

# Kryptografisches Secret, mit openssl rand -hex 64 generieren
SECRET_KEY=OVERWRITE_ME

# PostgreSQL
POSTGRES_USER=taiga
POSTGRES_PASSWORD=OVERWRITE_ME

# RabbitMQ – für Events und asynchrone Aufgaben
RABBITMQ_USER=taiga
RABBITMQ_PASS=OVERWRITE_ME
RABBITMQ_VHOST=taiga
RABBITMQ_ERLANG_COOKIE=OVERWRITE_ME

# E-Mail; für Entwicklung console, für echten Versand smtp verwenden
EMAIL_BACKEND=console
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=OVERWRITE_ME
EMAIL_DEFAULT_FROM=taiga@deinedomain.de
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Datenschutz und Anhänge
ENABLE_TELEMETRY=False
ATTACHMENTS_MAX_AGE=360

# Optionale Registrierung und Integrationen.
# Backend-Werte verwenden True/False, Frontend-Werte true/false.
PUBLIC_REGISTER_ENABLED=False
PUBLIC_REGISTER_ENABLED_FRONT=false
ENABLE_GITHUB_AUTH=False
ENABLE_GITHUB_AUTH_FRONT=false
GITHUB_API_CLIENT_ID=
GITHUB_API_CLIENT_SECRET=OVERWRITE_ME
ENABLE_GITLAB_AUTH=False
ENABLE_GITLAB_AUTH_FRONT=false
GITLAB_API_CLIENT_ID=
GITLAB_API_CLIENT_SECRET=OVERWRITE_ME
GITLAB_URL=
ENABLE_SLACK=False
ENABLE_SLACK_FRONT=false
ENABLE_GITHUB_IMPORTER=False
ENABLE_GITHUB_IMPORTER_FRONT=false
GITHUB_IMPORTER_CLIENT_ID=
GITHUB_IMPORTER_CLIENT_SECRET=OVERWRITE_ME
ENABLE_JIRA_IMPORTER=False
ENABLE_JIRA_IMPORTER_FRONT=false
JIRA_IMPORTER_CONSUMER_KEY=
JIRA_IMPORTER_CERT=
JIRA_IMPORTER_PUB_CERT=
ENABLE_TRELLO_IMPORTER=False
ENABLE_TRELLO_IMPORTER_FRONT=false
TRELLO_IMPORTER_API_KEY=
TRELLO_IMPORTER_SECRET_KEY=OVERWRITE_ME
