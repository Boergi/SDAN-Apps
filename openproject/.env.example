##
# OpenProject – Umgebungsvariablen
#
# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env
#
# Alternativ das Skript generate-env.sh verwenden:
#   bash generate-env.sh
#
# Alle möglichen Variablen:
#   https://www.openproject.org/docs/installation-and-operations/configuration/environment/
##

# OpenProject-Image-Tag (17-slim, 17, 16-slim, …)
TAG=17-slim

# Postgres-Version (17, 16, 13, …)
POSTGRES_VERSION=17

# Öffentlicher Hostname (z. B. openproject.deinedomain.de)
OPENPROJECT_HOST__NAME=openproject.deinedomain.de

# HTTPS-Modus: true = TLS-Terminierung am Gateway (empfohlen)
OPENPROJECT_HTTPS=true

# Secret Key Base – mit openssl rand -hex 64 generieren
# WICHTIG: Diesen Wert sicher aufbewahren! Bei Verlust sind Sessions und
# verschlüsselte Datenbankinhalte unlesbar.
SECRET_KEY_BASE=OVERWRITE_ME

# Postgres-Passwort
POSTGRES_PASSWORD=p4ssw0rd

# Datenbank-URL (nur ändern, wenn abweichende Konfiguration gewünscht)
# DATABASE_URL=postgres://postgres:p4ssw0rd@db/openproject?pool=20&encoding=unicode&reconnect=true

# Threads
RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16

# Proxy-Netzwerk (muss mit dem Gateway-Netzwerk übereinstimmen)
PROXY_NETWORK=proxy_net

# Kollaboratives Editieren (optional, für Echtzeit-Bearbeitung)
# Secret mit openssl rand -hex 32 generieren
COLLABORATIVE_SERVER_SECRET=OVERRIDE_ME_PLEASE
# WebSocket-URL (angepasst an deinen Hostnamen)
# COLLABORATIVE_SERVER_URL=wss://openproject.deinedomain.de/hocuspocus

# E-Mail (optional, für ausgehende E-Mails)
# IMAP_ENABLED=false
# OPENPROJECT_EMAIL__DELIVERY__METHOD=smtp
# OPENPROJECT_SMTP_ADDRESS=smtp.example.com
# OPENPROJECT_SMTP_PORT=587
# OPENPROJECT_SMTP_USER_NAME=user@example.com
# OPENPROJECT_SMTP_PASSWORD=secret
# OPENPROJECT_SMTP_AUTHENTICATION=login
# OPENPROJECT_SMTP_ENABLE__STARTTLS__AUTO=true
# OPENPROJECT_SMTP_DOMAIN=example.com